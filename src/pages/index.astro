---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/layout.astro";
import WhatsAppLink from "../components/whatsapp-link.astro";
import MainNav from "../components/main-nav.astro";
import HeroImage from "../assets/images/hero.webp";
import { getBusinessStructuredData, getHomeData } from "../data/home";
import Services from "../components/services.astro";
import Schedule from "../components/schedule.astro";

if (!Astro.site) {
	throw new Error("Astro.site must be configured.");
}

const data = getHomeData();
const structuredData = getBusinessStructuredData(Astro.site);

const {
	aboutSections,
	businessInfo,
	contactItems,
	pricingPeriods,
	pricingPlans,
} = data;

const formatPlanDetail = (
	classes: number | "unlimited",
	availability: string,
) =>
	classes === "unlimited"
		? `Clases ilimitadas · ${availability}`
		: `${classes} clases · ${availability}`;
---

<BaseLayout
	title="Box 28012 | Crosstraining y entrenamiento funcional en Madrid"
	description="Box 28012 es un espacio de entrenamiento funcional en Madrid centro con grupos reducidos, técnica y atención personalizada."
>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(structuredData)}
	/>

	<MainNav />

	<main class="relative overflow-hidden">
		<!-- INTRO/HERO -->
		<section
			id="inicio"
			class="relative isolate flex min-h-svh w-full items-end overflow-hidden bg-black"
		>
			<Image
				src={HeroImage}
				alt="Salón principal del Box 28012"
				priority
				class="absolute inset-0 -z-20 size-full object-cover object-[48%_center] md:object-center"
			/>

			<div
				aria-hidden="true"
				class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(0,0,0,0.28)_0%,rgba(0,0,0,0.08)_30%,rgba(0,0,0,0.82)_100%)] md:bg-[linear-gradient(90deg,rgba(0,0,0,0.74)_0%,rgba(0,0,0,0.38)_42%,rgba(0,0,0,0.04)_72%),linear-gradient(180deg,rgba(0,0,0,0.32)_0%,transparent_34%,rgba(0,0,0,0.58)_100%)]"
			>
			</div>

			<div
				class="mx-auto w-full max-w-350 px-6 pb-10 pt-32 md:px-10 md:pb-16 lg:pb-20"
			>
				<div class="max-w-205">
					<p
						class="mb-4 font-serif text-xl uppercase tracking-[-0.04em] text-text md:mb-6 md:text-2xl"
					>
						{businessInfo.name}
					</p>

					<h1
						class="max-w-205 text-pretty text-[clamp(2.75rem,6vw,5rem)] font-medium leading-[0.96] tracking-[-0.045em] text-text"
					>
						Entrenamiento funcional en el corazón de Madrid.
					</h1>

					<p
						class="mt-5 max-w-145 text-pretty text-lg leading-snug text-text/90 md:mt-7 md:text-xl"
					>
						Grupos reducidos. Más atención. Mejor entrenamiento.
					</p>

					<div class="mt-7 md:mt-9">
						<WhatsAppLink class="px-7 font-semibold uppercase tracking-[0.06em] md:px-8">
							<Icon name="whatsapp" class="size-6" aria-hidden="true" />
							¡PRUEBA GRATIS!
						</WhatsAppLink>
					</div>
				</div>
			</div>
		</section>

		<!-- SERVICIOS -->
		<div class="max-w-350 mx-auto">
			<section id="actividades" class="px-4 md:px-10 py-14 md:py-30">
				<div class="space-y-2">
					<h2 class="text-section-title">SERVICIOS</h2>
					<p class="text-lead">
						Dos formas de entrenar, siempre con atención cercana.
					</p>
				</div>

				<Services />
			</section>
		</div>

		<!-- HORARIOS -->
		<div class="max-w-350 mx-auto">
			<Schedule />
		</div>

		<!-- TARIFAS -->
		<div class="mx-auto max-w-350">
			<section
				id="tarifas"
				class="grid grid-cols-1 gap-10 px-4 py-14 md:gap-12 lg:grid-cols-[minmax(16rem,0.35fr)_minmax(0,0.65fr)] lg:gap-16 lg:px-10 lg:py-30"
			>
				<div class="space-y-2 pt-10">
					<h2 class="text-section-title">Tarifas</h2>

					<div class="max-w-110 space-y-2 py-4 md:pt-8">
						<p class="text-lead text-text">Sin matrícula. Sin permanencia.</p>
						<p class="text-body">
							Escríbenos y te ayudamos a elegir la tarifa que mejor se adapte a
							tus objetivos.
						</p>
					</div>

					<WhatsAppLink>
						Consultar por WhatsApp
						<Icon
							name="arrow-right"
							class="size-5 text-accent"
							aria-hidden="true"
						/>
					</WhatsAppLink>
				</div>

				<div class="grid min-w-0 content-center" data-pricing>
					<div
						role="tablist"
						aria-label="Periodo de la tarifa"
						class="flex border-b border-white/20"
					>
						{
							pricingPeriods.map((period, index) => (
								<button
									type="button"
									role="tab"
									id={`pricing-tab-${period.id}`}
									aria-controls="pricing-panel"
									aria-selected={index === 0 ? "true" : "false"}
									tabindex={index === 0 ? 0 : -1}
									data-pricing-tab={period.id}
									class="relative px-1 py-4 text-xs font-medium uppercase tracking-[0.16em] text-muted first:mr-7 after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:scale-x-0 after:bg-accent after:content-[''] aria-selected:text-text aria-selected:after:scale-x-100 md:text-sm"
								>
									{period.label}
								</button>
							))
						}
					</div>

					<div
						id="pricing-panel"
						role="tabpanel"
						aria-labelledby="pricing-tab-monthly"
					>
						{
							pricingPlans.map((plan, index) => {
								const monthly = plan.periods.monthly;
								const quarterly = plan.periods.quarterly;

								return (
									<article
										data-pricing-plan
										data-price-monthly={monthly.price}
										data-classes-monthly={monthly.classes}
										data-price-quarterly={quarterly.price}
										data-classes-quarterly={quarterly.classes}
										data-availability={plan.availability}
										class:list={[
											"grid min-w-0 grid-cols-[3rem_1px_minmax(0,1fr)] gap-x-5 border-b border-white/10 py-6 last:border-b-0",
											"md:min-h-24 md:grid-cols-[3rem_1px_minmax(9rem,1fr)_7rem_minmax(9rem,1.2fr)] md:items-center md:gap-6 md:py-8",
											"lg:grid-cols-[3.5rem_1px_minmax(11rem,1fr)_8rem_minmax(11rem,1.2fr)] lg:gap-8",
											"xl:grid-cols-[4rem_1px_minmax(13rem,1fr)_9rem_minmax(13rem,1.2fr)] xl:gap-10",
										]}
									>
										<span class="pt-1 text-lg font-bold leading-none text-accent md:pt-0 md:text-xl">
											{String(index + 1).padStart(2, "0")}
										</span>

										<span class="h-full min-h-16 w-px bg-white/20 md:h-8 md:min-h-0" />

										<div class="grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-start gap-x-4 gap-y-2 md:contents">
											<h3 class="text-base font-normal uppercase leading-none tracking-wide text-text md:text-xl lg:text-2xl">
												{plan.name}
											</h3>

											<p class="text-price whitespace-nowrap font-normal text-text tabular-nums" data-plan-price>
												{monthly.price}€
											</p>

											<p class="col-span-2 text-pretty text-xs uppercase leading-tight tracking-wide text-subtle md:col-auto md:text-sm lg:text-base" data-plan-detail>
												{formatPlanDetail(monthly.classes, plan.availability)}
											</p>
										</div>
									</article>
								);
							})
						}
					</div>
				</div>
			</section>
		</div>

		<script>
			const pricingSections = document.querySelectorAll<HTMLElement>("[data-pricing]");

			pricingSections.forEach((pricing) => {
				const tabs = Array.from(
					pricing.querySelectorAll<HTMLButtonElement>("[data-pricing-tab]"),
				);
				const plans = Array.from(
					pricing.querySelectorAll<HTMLElement>("[data-pricing-plan]"),
				);
				const panel = pricing.querySelector<HTMLElement>("[role='tabpanel']");

				const selectPeriod = (selectedTab: HTMLButtonElement) => {
					const period = selectedTab.dataset.pricingTab;
					if (period !== "monthly" && period !== "quarterly") return;

					tabs.forEach((tab) => {
						const isSelected = tab === selectedTab;
						tab.setAttribute("aria-selected", String(isSelected));
						tab.tabIndex = isSelected ? 0 : -1;
					});

					panel?.setAttribute("aria-labelledby", selectedTab.id);

					plans.forEach((plan) => {
						const price = plan.dataset[`price${period[0]?.toUpperCase()}${period.slice(1)}`];
						const classes = plan.dataset[`classes${period[0]?.toUpperCase()}${period.slice(1)}`];
						const availability = plan.dataset.availability;
						const priceElement = plan.querySelector<HTMLElement>("[data-plan-price]");
						const detailElement = plan.querySelector<HTMLElement>("[data-plan-detail]");

						if (priceElement && price) priceElement.textContent = `${price}€`;
						if (detailElement && classes && availability) {
							detailElement.textContent =
								classes === "unlimited"
									? `Clases ilimitadas · ${availability}`
									: `${classes} clases · ${availability}`;
						}
					});
				};

				tabs.forEach((tab, index) => {
					tab.addEventListener("click", () => selectPeriod(tab));
					tab.addEventListener("keydown", (event) => {
						let nextIndex: number | undefined;

						if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
						if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
						if (event.key === "Home") nextIndex = 0;
						if (event.key === "End") nextIndex = tabs.length - 1;
						if (nextIndex === undefined) return;

						event.preventDefault();
						const nextTab = tabs[nextIndex];
						if (!nextTab) return;
						selectPeriod(nextTab);
						nextTab.focus();
					});
				});
			});
		</script>

		<!-- SOBRE EL BOX -->
		<div class="max-w-350 mx-auto">
			<section id="el-box" class="scroll-mt-18 px-4 py-14 md:px-10 md:py-30">
				<header class="max-w-205 space-y-3 md:space-y-4">
					<h2 class="text-section-title">SOBRE EL BOX</h2>
					<p class="text-lead text-pretty">
						Desde 2019 construyendo una forma diferente de entrenar en
						Lavapiés.
					</p>
				</header>

				<div class="mt-12 space-y-12 md:mt-18 md:space-y-16 lg:mt-24 lg:space-y-20">
					{
						aboutSections.map((section, index) => (
							<article class="grid items-center gap-8 md:gap-12 lg:grid-cols-2 lg:gap-20 xl:gap-28">
								<figure
									class:list={[
										"aspect-8/5 overflow-hidden bg-black",
										index === 1 && "lg:order-2",
									]}
								>
									<Image
										src={section.image}
										alt={section.alt}
										class="size-full object-cover"
									/>
								</figure>

								<div
									class:list={[
										"max-w-135 space-y-5 md:space-y-6 lg:justify-self-center",
										index === 1 && "lg:order-1 lg:justify-self-start",
									]}
								>
									<div class="h-0.5 w-10 bg-accent" />
									<h3 class="text-card-title text-pretty">
										{section.title}
									</h3>

									<div class="space-y-4 text-body leading-relaxed md:space-y-5">
										{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
									</div>

									{section.emphasis && (
										<p class="max-w-125 pt-2 text-lg font-medium leading-relaxed text-text md:pt-4 md:text-xl">
											{section.emphasis}
										</p>
									)}
								</div>
							</article>
						))
					}
				</div>
			</section>
		</div>

		<!-- PONTE EN CONTACTO -->
		<section id="contacto" class="isolate py-14 md:py-30">
			<div class="max-w-350 mx-auto px-4 md:px-10">
				<div class="space-y-10">
					<div class="space-y-6">
						<div>
							<p class="text-lead max-w-150 text-pretty text-muted pb-4">
								En Box 28012 entrenamos en grupos reducidos para ofrecerte una
								experiencia totalmente personalizada.
							</p>
							<div class="h-0.5 bg-accent w-12"></div>
						</div>

						<div class="space-y-4">
							<h2 class="text-section-title">¿Tienes alguna duda?</h2>
							<p class="text-lead">
								Escríbenos por WhatsApp para consultar horarios, resolver dudas
								o reservar tu primera sesión gratuita.
							</p>
						</div>

						<div>
							<WhatsAppLink>
								<Icon name="whatsapp" class="size-7" aria-hidden="true" />
								Escribir por WhatsApp
								<Icon
									name="arrow-right"
									class="size-5 text-accent"
									aria-hidden="true"
								/>
							</WhatsAppLink>
						</div>
					</div>

					<div class="relative lg:h-40 w-full">
						<div
							class="lg:absolute z-10 lg:left-1/2 lg:-translate-x-1/2 lg:top-10 bg-surface py-6 md:py-8 px-4 md:px-10 lg:px-20 w-full rounded-xs flex flex-col lg:flex-row gap-y-6 items-start justify-between max-w-6xl mx-auto"
						>
							{
								contactItems.map((item) => (
									<div class="flex items-start gap-4">
										<Icon
											name={item.icon}
											class="size-6 md:size-8 text-accent"
											aria-hidden="true"
										/>
										<div>
											<p class="text-eyebrow">{item.title}</p>
											<div class="text-body text-text">
												{item.lines ? (
													item.lines.map((line) => <p>{line}</p>)
												) : (
													<a
														href={item.href}
														target={item.external ? "_blank" : undefined}
														rel={
															item.external ? "noopener noreferrer" : undefined
														}
													>
														{item.text}
													</a>
												)}
											</div>
										</div>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</div>

			<div class="pt-4 md:pt-0 px-4 md:px-0 h-100 md:h-112.5">
				<iframe
					src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6075.61906106362!2d-3.7029538!3d40.4130701!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd4228802012091b%3A0x5b588730434e9bca!2sCalle%20de%20los%20Ca%C3%B1izares%2C%203%2C%20Centro%2C%2028012%20Madrid%2C%20Espa%C3%B1a!5e0!3m2!1ses-419!2sar!4v1779226540583!5m2!1ses-419!2sar"
					title="Mapa de ubicación de Box 28012 en Madrid"
					width="100%"
					height="100%"
					style="border:0;"
					allowfullscreen=""
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					class="grayscale"></iframe>
			</div>
		</section>

		<!-- FIXED LEFT TITLE -->
		<div
			aria-hidden="true"
			class="hidden fixed right-0 bottom-24 transform -rotate-90 lg:flex items-center gap-2"
		>
			<span class="text-muted font-serif text-xs uppercase"
				>{businessInfo.name}</span
			>
			<div class="h-0.5 bg-muted w-10"></div>
		</div>
	</main>

	<!-- FOOTER -->
	<div class="pt-20 md:pt-30">
		<footer class="bg-black/40">
			<div class="max-w-7xl mx-auto px-4 md:px-10 py-10 md:py-16">
				<div class="grid gap-10 md:gap-16 lg:grid-cols-[1.15fr_1fr]">
					<div class="space-y-6">
						<div>
							<p
								class="font-serif text-3xl md:text-4xl tracking-[-0.04em] uppercase"
							>
								{businessInfo.name}
							</p>
							<p class="text-eyebrow tracking-[0.28em]">
								{businessInfo.city}
							</p>
						</div>

						<p class="text-body max-w-md">
							Entrenamiento funcional en grupos reducidos en Madrid centro.
						</p>
					</div>

					<div class="flex flex-col justify-between gap-10">
						<div class="grid gap-6 md:gap-10 sm:grid-cols-2">
							<div>
								<p class="text-eyebrow">Dirección</p>
								<p class="text-body mt-3">
									{businessInfo.addressLine1}<br />
									{businessInfo.postalCode} Madrid
								</p>
							</div>

							<div>
								<p class="text-eyebrow">Contacto</p>
								<div class="text-body mt-3 space-y-2">
									<WhatsAppLink
										class="block justify-start md:justify-center"
										variant="ghost">{businessInfo.phone}</WhatsAppLink
									>
									<a
										class="block"
										target="_blank"
										rel="noopener noreferrer"
										href={businessInfo.instagramUrl}
									>
										{businessInfo.instagramHandle}
									</a>
								</div>
							</div>
						</div>

						<div
							class="flex flex-col gap-6 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between"
						>
							<WhatsAppLink
								class="font-medium text-base flex items-center gap-3 justify-start"
								variant="ghost"
							>
								Primera sesión gratuita
								<Icon
									name="arrow-right"
									class="size-6 text-accent"
									aria-hidden="true"
								/>
							</WhatsAppLink>

							<p class="text-xs text-muted">
								© 2026 Box 28012 · Todos los derechos reservados
							</p>
						</div>
					</div>
				</div>
			</div>

			<div
				class="relative flex h-60 md:h-86 items-center justify-center overflow-hidden"
			>
				<div
					class="absolute inset-0 bg-[url('/images/mosaic-v2.webp')] bg-size-[240px_240px] md:bg-size-[340px_340px] bg-center bg-repeat"
				>
				</div>

				<div class="absolute inset-0 bg-black/20"></div>

				<div
					class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,0.85)_0%,transparent_25%)]"
				>
				</div>

				<div class="relative z-10 text-center">
					<p
						class="font-serif text-[clamp(4rem,15vw,9rem)] uppercase leading-none text-text"
					>
						{businessInfo.name}
					</p>

					<p
						class="font-serif text-[clamp(1.25rem,3vw,3rem)] font-semibold uppercase tracking-wider leading-none text-red-500"
					>
						{businessInfo.cityShort}
					</p>
				</div>
			</div>
		</footer>
	</div>
</BaseLayout>
