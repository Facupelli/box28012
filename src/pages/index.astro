---
import BaseLayout from "../layouts/layout.astro";
import MainNav from "../components/main-nav.astro";
import Hero from "../components/hero.astro";
import Services from "../components/services.astro";
import Schedule from "../components/schedule.astro";
import Pricing from "../components/pricing.astro";
import AboutStory from "../components/about-story.astro";
import Team from "../components/team.astro";
import Contact from "../components/contact.astro";
import Footer from "../components/footer.astro";
import { getBusinessStructuredData, getHomeData } from "../data/home";

if (!Astro.site) {
  throw new Error("Astro.site must be configured.");
}

const { businessInfo } = getHomeData();
const structuredData = getBusinessStructuredData(Astro.site);
---

<BaseLayout
  title="Box 28012 | Crosstraining y entrenamiento funcional en Madrid"
  description="Box 28012 es un espacio de entrenamiento funcional en Madrid centro con grupos reducidos, técnica y atención personalizada."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  ></script>
  <MainNav />

  <main class="relative overflow-hidden">
    <Hero />
    <Services />
    <div class="mx-auto max-w-350">
      <Schedule />
    </div>
    <Pricing />
    <AboutStory />
    <Team />
    <Contact />

    <!-- FIXED BOX STRIP -->
    <div
      aria-hidden="true"
      class="hidden fixed right-0 bottom-24 transform -rotate-90 lg:flex items-center gap-2"
    >
      <span class="text-muted font-pontejos-identity text-xs uppercase">
        {businessInfo.name}
      </span>
      <div class="h-0.5 bg-muted w-10"></div>
    </div>
  </main>

  <Footer />
</BaseLayout>
