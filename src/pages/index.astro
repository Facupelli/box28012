---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/layout.astro";
import WhatsAppLink from "../components/whatsapp-link.astro";
import MainNav from "../components/main-nav.astro";
import HeroImage from "../assets/images/hero.webp";
import { getBusinessStructuredData, getHomeData } from "../data/home";
import Services from "../components/services.astro";
import Schedule from "../components/schedule.astro";
import Pricing from "../components/pricing.astro";

if (!Astro.site) {
  throw new Error("Astro.site must be configured.");
}

const data = getHomeData();
const structuredData = getBusinessStructuredData(Astro.site);

const { aboutSections, businessInfo, contactItems } = data;
---

<BaseLayout
  title="Box 28012 | Crosstraining y entrenamiento funcional en Madrid"
  description="Box 28012 es un espacio de entrenamiento funcional en Madrid centro con grupos reducidos, técnica y atención personalizada."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  ></script>
  <MainNav />

  <main class="relative overflow-hidden">
    <!-- INTRO/HERO -->
    <section
      id="inicio"
      class="relative isolate flex min-h-svh w-full items-end overflow-hidden bg-black"
    >
      <Image
        src={HeroImage}
        alt="Salón principal del Box 28012"
        priority
        class="absolute inset-0 -z-20 size-full object-cover object-[48%_center] md:object-center"
      />

      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(0,0,0,0.24)_0%,rgba(0,0,0,0.08)_30%,rgba(0,0,0,0.84)_100%)] md:bg-[linear-gradient(90deg,rgba(0,0,0,0.82)_0%,rgba(0,0,0,0.58)_35%,rgba(0,0,0,0.12)_67%,rgba(0,0,0,0.02)_100%),linear-gradient(180deg,rgba(0,0,0,0.28)_0%,transparent_36%,rgba(0,0,0,0.62)_100%)]"
      ></div>

      <div class="mx-auto w-full max-w-350 px-6 pb-10 pt-32 md:px-10 md:pb-16 lg:pb-20">
        <div class="max-w-230">
          <p class="mb-5 font-chulapa text-sm uppercase tracking-[0.22em] text-text/85 md:mb-7 md:text-base">
            Lavapiés <span class="mx-2 text-text/55">—</span> Calle Cañizares, 3
          </p>

          <h1 class="max-w-230 text-pretty font-pontejos-display text-[clamp(3.25rem,6.5vw,6.5rem)] font-normal leading-[0.88] tracking-[-0.025em] text-text">
            Entrenamiento funcional en el corazón de Madrid.
          </h1>

          <p class="mt-5 max-w-160 text-pretty font-chulapa text-lg leading-snug text-text/90 md:mt-7 md:text-xl">
            Grupos reducidos. Más atención. Mejor entrenamiento.
          </p>

          <div class="mt-8 md:mt-10">
            <WhatsAppLink class="group inline-flex items-center gap-6 rounded-none border-0 bg-text px-6 py-4 font-chulapa text-base font-bold uppercase tracking-[0.08em] text-black shadow-none transition-colors md:px-7 md:py-4 md:text-lg">
              ¡PRUEBA GRATIS!
              <span
                aria-hidden="true"
                class="text-xl font-normal leading-none text-[#d52b2f] transition-transform group-hover:translate-x-1"
              >
                →
              </span>
            </WhatsAppLink>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICIOS -->
    <div class="mx-auto max-w-350">
      <section id="servicios" class="px-4 py-14 md:px-10 md:py-30">
        <h2 class="font-chulapa text-sm uppercase tracking-[0.22em] text-text/80 md:text-base">
          SERVICIOS
        </h2>

        <Services />
      </section>
    </div>

    <!-- HORARIOS -->
    <div class="max-w-350 mx-auto">
      <Schedule />
    </div>

    <!-- TARIFAS -->
    <Pricing />

    <!-- SOBRE EL BOX -->
    <div class="max-w-350 mx-auto">
      <section id="el-box" class="scroll-mt-18 px-4 py-14 md:px-10 md:py-30">
        <header class="max-w-205 space-y-3 md:space-y-4">
          <h2 class="text-section-title">SOBRE EL BOX</h2>
          <p class="text-lead text-pretty">
            Desde 2019 construyendo una forma diferente de entrenar en Lavapiés.
          </p>
        </header>

        <div class="mt-12 space-y-12 md:mt-18 md:space-y-16 lg:mt-24 lg:space-y-20">
          {aboutSections.map((section, index) => (
            <article class="grid items-center gap-8 md:gap-12 lg:grid-cols-2 lg:gap-20 xl:gap-28">
              <figure
                class:list={[
                  "aspect-8/5 overflow-hidden bg-black",
                  index === 1 && "lg:order-2",
                ]}
              >
                <Image
                  src={section.image}
                  alt={section.alt}
                  class="size-full object-cover"
                />
              </figure>

              <div
                class:list={[
                  "max-w-135 space-y-5 md:space-y-6 lg:justify-self-center",
                  index === 1 && "lg:order-1 lg:justify-self-start",
                ]}
              >
                <div class="h-0.5 w-10 bg-accent" />
                <h3 class="text-card-title text-pretty">{section.title}</h3>

                <div class="space-y-4 text-body leading-relaxed md:space-y-5">
                  {section.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>

                {section.emphasis && (
                  <p class="max-w-125 pt-2 text-lg font-medium leading-relaxed text-text md:pt-4 md:text-xl">
                    {section.emphasis}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>

    <!-- PONTE EN CONTACTO -->
    <section id="contacto" class="isolate py-14 md:py-30">
      <div class="max-w-350 mx-auto px-4 md:px-10">
        <div class="space-y-10">
          <div class="space-y-6">
            <div>
              <p class="text-lead max-w-150 text-pretty text-muted pb-4">
                En Box 28012 entrenamos en grupos reducidos para ofrecerte una
                experiencia totalmente personalizada.
              </p>
              <div class="h-0.5 bg-accent w-12"></div>
            </div>

            <div class="space-y-4">
              <h2 class="text-section-title">¿Tienes alguna duda?</h2>
              <p class="text-lead">
                Escríbenos por WhatsApp para consultar horarios, resolver dudas
                o reservar tu primera sesión gratuita.
              </p>
            </div>

            <div>
              <WhatsAppLink>
                <Icon name="whatsapp" class="size-7" aria-hidden="true" />
                Escribir por WhatsApp
                <Icon
                  name="arrow-right"
                  class="size-5 text-accent"
                  aria-hidden="true"
                />
              </WhatsAppLink>
            </div>
          </div>

          <div class="relative lg:h-40 w-full">
            <div class="lg:absolute z-10 lg:left-1/2 lg:-translate-x-1/2 lg:top-10 bg-surface py-6 md:py-8 px-4 md:px-10 lg:px-20 w-full rounded-xs flex flex-col lg:flex-row gap-y-6 items-start justify-between max-w-6xl mx-auto">
              {contactItems.map((item) => (
                <div class="flex items-start gap-4">
                  <Icon
                    name={item.icon}
                    class="size-6 md:size-8 text-accent"
                    aria-hidden="true"
                  />
                  <div>
                    <p class="text-eyebrow">{item.title}</p>
                    <div class="text-body text-text">
                      {item.lines ? (
                        item.lines.map((line) => <p>{line}</p>)
                      ) : (
                        <a
                          href={item.href}
                          target={item.external ? "_blank" : undefined}
                          rel={
                            item.external ? "noopener noreferrer" : undefined
                          }
                        >
                          {item.text}
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="pt-4 md:pt-0 px-4 md:px-0 h-100 md:h-112.5">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6075.61906106362!2d-3.7029538!3d40.4130701!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd4228802012091b%3A0x5b588730434e9bca!2sCalle%20de%20los%20Ca%C3%B1izares%2C%203%2C%20Centro%2C%2028012%20Madrid%2C%20Espa%C3%B1a!5e0!3m2!1ses-419!2sar!4v1779226540583!5m2!1ses-419!2sar"
          title="Mapa de ubicación de Box 28012 en Madrid"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="grayscale"
        ></iframe>
      </div>
    </section>

    <!-- FIXED LEFT TITLE -->
    <div
      aria-hidden="true"
      class="hidden fixed right-0 bottom-24 transform -rotate-90 lg:flex items-center gap-2"
    >
      <span class="text-muted font-serif text-xs uppercase">
        {businessInfo.name}
      </span>
      <div class="h-0.5 bg-muted w-10"></div>
    </div>
  </main>

  <!-- FOOTER -->
  <div class="pt-20 md:pt-30">
    <footer class="bg-black/40">
      <div class="max-w-7xl mx-auto px-4 md:px-10 py-10 md:py-16">
        <div class="grid gap-10 md:gap-16 lg:grid-cols-[1.15fr_1fr]">
          <div class="space-y-6">
            <div>
              <p class="font-serif text-3xl md:text-4xl tracking-[-0.04em] uppercase">
                {businessInfo.name}
              </p>
              <p class="text-eyebrow tracking-[0.28em]">{businessInfo.city}</p>
            </div>

            <p class="text-body max-w-md">
              Entrenamiento funcional en grupos reducidos en Madrid centro.
            </p>
          </div>

          <div class="flex flex-col justify-between gap-10">
            <div class="grid gap-6 md:gap-10 sm:grid-cols-2">
              <div>
                <p class="text-eyebrow">Dirección</p>
                <p class="text-body mt-3">
                  {businessInfo.addressLine1}
                  <br />
                  {businessInfo.postalCode} Madrid
                </p>
              </div>

              <div>
                <p class="text-eyebrow">Contacto</p>
                <div class="text-body mt-3 space-y-2">
                  <WhatsAppLink
                    class="block justify-start md:justify-center"
                    variant="ghost"
                  >
                    {businessInfo.phone}
                  </WhatsAppLink>
                  <a
                    class="block"
                    target="_blank"
                    rel="noopener noreferrer"
                    href={businessInfo.instagramUrl}
                  >
                    {businessInfo.instagramHandle}
                  </a>
                </div>
              </div>
            </div>

            <div class="flex flex-col gap-6 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
              <WhatsAppLink
                class="font-medium text-base flex items-center gap-3 justify-start"
                variant="ghost"
              >
                Primera sesión gratuita
                <Icon
                  name="arrow-right"
                  class="size-6 text-accent"
                  aria-hidden="true"
                />
              </WhatsAppLink>

              <p class="text-xs text-muted">
                © 2026 Box 28012 · Todos los derechos reservados
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="relative flex h-60 md:h-86 items-center justify-center overflow-hidden">
        <div class="absolute inset-0 bg-[url('/images/mosaic-v2.webp')] bg-size-[240px_240px] md:bg-size-[340px_340px] bg-center bg-repeat"></div>

        <div class="absolute inset-0 bg-black/20"></div>

        <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,0.85)_0%,transparent_25%)]"></div>

        <div class="relative z-10 text-center">
          <p class="font-serif text-[clamp(4rem,15vw,9rem)] uppercase leading-none text-text">
            {businessInfo.name}
          </p>

          <p class="font-serif text-[clamp(1.25rem,3vw,3rem)] font-semibold uppercase tracking-wider leading-none text-red-500">
            {businessInfo.cityShort}
          </p>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
