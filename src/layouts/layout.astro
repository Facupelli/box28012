---
import "../styles/global.css";
import BaseHead from "../components/base-head.astro";
import { Font } from "astro:assets";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<html lang="es" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <Font
      cssVariable="--font-brand"
      preload={[{ weight: 400, style: "normal", subset: "latin" }]}
    />

    <Font
      cssVariable="--font-dm"
      preload={[
        { weight: 400, style: "normal", subset: "latin" },
        { weight: 500, style: "normal", subset: "latin" },
      ]}
    />

    <Font cssVariable="--astro-font-anton" />
    <Font cssVariable="--astro-font-chulapa" />
    <Font cssVariable="--astro-font-pontejos-display" />
    <Font cssVariable="--astro-font-pontejos-identity" />

    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="bg-bg min-h-screen">
    <slot />
  </body>
</html>
