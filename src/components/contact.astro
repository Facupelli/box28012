---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import WhatsAppLink from "./whatsapp-link.astro";
import FreeTrialCTA from "./free-trial-cta.astro";
import { getHomeData } from "../data/home";

const { businessInfo, contact } = getHomeData();
---

<section id="contacto" class="isolate bg-black/40">
  <div class="relative overflow-hidden lg:flex lg:min-h-[calc(clamp(36rem,33vw,42rem)-var(--spacing-section))] lg:items-center">
    <div class="relative z-10 mx-auto w-full max-w-350 px-4 md:px-10">
      <div class="py-section lg:w-[min(58vw,56rem)]">
        <h2 class="text-page-title max-w-[16ch] text-text">
          {contact.headline}
        </h2>
        <p class="text-body mt-6 max-w-[54ch] text-muted md:mt-8">
          {contact.description}
        </p>
        <div class="mt-8 md:mt-10">
          <FreeTrialCTA />
        </div>
      </div>
    </div>

    <div class="relative aspect-[4/3] w-full lg:absolute lg:top-0 lg:right-0 lg:bottom-0 lg:aspect-auto lg:w-[min(60vw,75rem)]">
      <Image
        src={contact.image}
        alt={contact.imageAlt}
        widths={[480, 720, 960, 1200, 1448]}
        sizes="(min-width: 1400px) 1200px, (min-width: 1024px) 60vw, 100vw"
        class="size-full object-cover object-center [mask-image:linear-gradient(to_right,transparent_25%,black_55%)] lg:object-[right_30%]"
        loading="lazy"
      />
    </div>
  </div>

  <div class="grid border-t border-white/20 lg:grid-cols-[40%_minmax(0,1fr)] xl:grid-cols-[33%_minmax(0,1fr)]">
    <div class="flex flex-col divide-y divide-white/20 border-b border-white/20 px-4 md:px-10 lg:min-h-[clamp(26rem,29vw,37rem)] lg:pl-[max(2.5rem,calc((100vw-87.5rem)/2+2.5rem))] lg:pr-12">
      <div class="flex flex-1 items-start gap-5 py-6 md:gap-6 md:py-7 lg:items-center lg:gap-4">
        <Icon
          name="map-pin"
          class="mt-1 size-5 shrink-0 text-accent md:size-6 lg:mt-0 lg:size-9"
          aria-hidden="true"
        />
        <div>
          <p class="font-chulapa text-xs uppercase tracking-[0.18em] text-muted">
            DIRECCIÓN
          </p>
          <p class="mt-1 font-body text-base leading-relaxed text-text">
            {contact.address}
          </p>
        </div>
      </div>
      <div class="flex flex-1 items-start gap-5 py-6 md:gap-6 md:py-7 lg:items-center lg:gap-4">
        <Icon
          name="whatsapp"
          class="mt-1 size-5 shrink-0 text-accent md:size-6 lg:mt-0 lg:size-9"
          aria-hidden="true"
        />
        <div>
          <p class="font-chulapa text-xs uppercase tracking-[0.18em] text-muted">
            WHATSAPP
          </p>
          <WhatsAppLink
            variant="ghost"
            ariaLabel={`Escribir a Box 28012 por WhatsApp al ${contact.whatsapp}`}
            class="!w-fit !justify-start mt-1 font-body text-base leading-relaxed text-text hover:text-accent-text"
          >
            {contact.whatsapp}
          </WhatsAppLink>
        </div>
      </div>
      <div class="flex flex-1 items-start gap-5 py-6 md:gap-6 md:py-7 lg:items-center lg:gap-4">
        <Icon
          name="instagram"
          class="mt-1 size-5 shrink-0 text-accent md:size-6 lg:mt-0 lg:size-9"
          aria-hidden="true"
        />
        <div>
          <p class="font-chulapa text-xs uppercase tracking-[0.18em] text-muted">
            INSTAGRAM
          </p>
          <a
            href={businessInfo.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 inline-block font-body text-base leading-relaxed text-text hover:text-accent-text"
          >
            {contact.instagram}
          </a>
        </div>
      </div>
    </div>

    <div class="h-90 md:h-110 lg:h-auto lg:min-h-[clamp(26rem,29vw,37rem)]">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6075.61906106362!2d-3.7029538!3d40.4130701!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd4228802012091b%3A0x5b588730434e9bca!2sCalle%20de%20los%20Ca%C3%B1izares%2C%203%2C%20Centro%2C%2028012%20Madrid%2C%20Espa%C3%B1a!5e0!3m2!1ses-419!2sar!4v1779226540583!5m2!1ses-419!2sar"
        title="Mapa de ubicación de Box 28012 en Madrid"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="block size-full grayscale"
      ></iframe>
    </div>
  </div>
</section>
