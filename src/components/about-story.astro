---
import { Image } from "astro:assets";
import { getHomeData } from "../data/home";

const { aboutStory } = getHomeData();
---

<section id="el-box" class="bg-surface-warm text-bg">
  <div class="mx-auto max-w-350 lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,8fr)]">
    <div class="px-4 py-section md:px-10 lg:pr-16">
      <header>
        <p class="text-eyebrow text-bg/75">{aboutStory.label}</p>
        <div aria-hidden="true" class="mt-4 h-0.5 w-10 bg-accent"></div>
        <h2 class="text-page-title mt-7 md:mt-8">{aboutStory.title}</h2>
      </header>

      <div class="text-body mt-8 max-w-[45ch] space-y-4 text-bg/80 md:mt-9 md:space-y-5">
        {aboutStory.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>

    <div class="grid aspect-[4/3] grid-cols-[minmax(0,3fr)_minmax(0,1fr)] gap-1.5 md:gap-2 lg:mr-[min(0px,calc((87.5rem-100vw)/2))] lg:aspect-auto lg:min-h-160">
      <figure class="relative overflow-hidden bg-surface">
        <Image
          src={aboutStory.image}
          alt={aboutStory.alt}
          widths={[480, 720, 960, 1200, 1600]}
          sizes="(min-width: 1400px) calc(37.5vw + 122px), (min-width: 1024px) 47vw, 75vw"
          class="absolute inset-0 size-full object-cover object-center"
          loading="lazy"
        />
      </figure>
      <figure class="relative overflow-hidden bg-surface">
        <Image
          src={aboutStory.accentImage}
          alt={aboutStory.accentAlt}
          width={480}
          height={1600}
          fit="cover"
          widths={[240, 360, 480, 720]}
          sizes="(min-width: 1400px) calc(12.5vw + 41px), (min-width: 1024px) 16vw, 25vw"
          class="absolute inset-0 size-full object-cover object-center"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>
