---
import { Image, getImage } from "astro:assets";
import TransparentTile from "../assets/images/tiles/transparent-tile-1-cropped.png";
import { getHomeData } from "../data/home";

const { aboutStory } = getHomeData();
const backgroundTile = await getImage({
  src: TransparentTile,
  width: 520,
  format: "webp",
});
---

<section
  id="el-box"
  class="relative isolate scroll-mt-18 overflow-hidden bg-bg"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-[16%] left-0 hidden h-[52%] w-[clamp(150px,16vw,300px)] bg-size-[260px_260px] opacity-[0.07] [mask-image:linear-gradient(to_bottom,transparent_0%,black_22%,black_78%,transparent_100%)] lg:block"
    style={`background-image: url("${backgroundTile.src}")`}
  ></div>
  <div class="relative mx-auto grid max-w-350 gap-12 px-4 py-16 md:px-10 md:py-24 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-12 lg:py-32 xl:gap-18">
    <div class="lg:order-2 lg:pt-14">
      <header>
        <p class="font-chulapa text-xs uppercase tracking-[0.22em] text-muted md:text-sm">
          {aboutStory.label}
        </p>
        <div aria-hidden="true" class="mt-4 h-0.5 w-10 bg-accent"></div>
        <h2 class="mt-7 font-pontejos-display text-[clamp(3.125rem,4.2vw,4.875rem)] leading-[0.95] tracking-[-0.02em] text-text md:mt-8">
          {aboutStory.title.split(" ").map((word) => (
            <span class="block">{word}</span>
          ))}
        </h2>
      </header>

      <div class="mt-8 max-w-[39ch] space-y-4 font-body text-sm leading-[1.65] text-text/80 md:mt-9 md:space-y-5 md:text-[0.9375rem]">
        {aboutStory.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>

    <div class="relative lg:order-1 lg:self-start lg:pb-[14%]">
      <figure class="aspect-[4/5] w-[84%] overflow-hidden bg-black lg:w-[78%]">
        <Image
          src={aboutStory.image}
          alt={aboutStory.alt}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1400px) 650px, (min-width: 1024px) 46vw, 80vw"
          class="size-full object-cover object-center"
        />
      </figure>
      <figure class="relative z-20 -mt-14 ml-auto aspect-[4/3] w-[69%] overflow-hidden bg-black lg:absolute lg:top-[47%] lg:right-[5%] lg:mt-0 lg:w-[66%]">
        <Image
          src={aboutStory.accentImage}
          alt={aboutStory.accentAlt}
          widths={[360, 600, 840]}
          sizes="(min-width: 1400px) 480px, (min-width: 1024px) 33vw, 62vw"
          class="size-full object-cover object-center"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>
