---
import { Icon } from "astro-icon/components";
import WhatsAppLink from "./whatsapp-link.astro";
---

<WhatsAppLink
  variant="ghost"
  message="¡Hola! Me gustaría reservar una sesión de prueba gratis."
  ariaLabel="Reservar una prueba gratis por WhatsApp"
  class="group inline-flex min-h-11 items-center gap-6 whitespace-nowrap rounded-none border-0 bg-[#E8E8E8] px-3.5 py-2.5 font-chulapa text-base font-bold uppercase tracking-[0.08em] text-black shadow-none transition-colors hover:bg-[#E8E8E8]/90 motion-reduce:transition-none md:px-4 md:py-3 md:text-lg"
>
  ¡PRUEBA GRATIS!
  <Icon
    name="arrow-right"
    class="size-5 shrink-0 text-accent transition-transform group-hover:translate-x-1 motion-reduce:transition-none"
    aria-hidden="true"
  />
</WhatsAppLink>
