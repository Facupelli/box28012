---
import { getHomeData } from "../data/home";

const { team } = getHomeData();
---

<div class="mx-auto max-w-350">
  <section id="equipo" class="scroll-mt-18 px-4 py-14 md:px-10 md:py-30">
    <header class="space-y-2">
      <h2 class="text-section-title text-text">{team.title}</h2>
      <p class="font-body text-base leading-relaxed text-muted md:text-lg">
        {team.headline}
      </p>
    </header>

    <div class="mt-12 grid grid-cols-1 gap-y-12 md:mt-18 md:gap-y-14 lg:grid-cols-2 lg:gap-x-14 lg:gap-y-0 xl:gap-x-18">
      {team.members.map((member, index) => (
        <article
          class:list={[
            "min-w-0",
            index === 1 &&
              "border-t border-white/20 pt-12 md:pt-14 lg:border-t-0 lg:pt-0",
          ]}
        >
          <header>
            <h3 class="font-pontejos-display text-[clamp(2.5rem,3.5vw,3.5rem)] font-normal leading-none tracking-[-0.02em] text-text">
              {member.name}
            </h3>
            <p class="mt-3 font-chulapa text-xs uppercase tracking-[0.18em] text-accent md:text-sm">
              {member.role}
            </p>
          </header>
          <div class="mt-8 max-w-[43ch] border-t border-white/20 pt-8 font-body text-base leading-relaxed text-text/80 space-y-4 md:space-y-5 md:text-lg">
            {member.description.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</div>
