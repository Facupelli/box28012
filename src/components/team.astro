---
import { Image } from "astro:assets";
import { getHomeData } from "../data/home";

const { team } = getHomeData();
---

<div class="mx-auto max-w-350">
  <section id="equipo" class="scroll-mt-18 px-4 py-14 md:px-10 md:py-30">
    <header>
      <h2 class="text-section-title text-text/80">{team.title}</h2>
    </header>

    <div class="mt-10 grid max-w-258 grid-cols-1 gap-12 md:mt-14 lg:grid-cols-2 lg:gap-14 xl:gap-18">
      {team.members.map((member) => (
        <article class="grid content-start">
          <figure class="aspect-[4/3] overflow-hidden bg-black">
            <Image
              src={member.image}
              alt={member.alt}
              class="size-full object-cover"
            />
          </figure>

          <div class="pt-6 md:pt-7">
            <h3 class="font-pontejos-display text-[clamp(2rem,2.25vw,2.5rem)] font-normal leading-[1] tracking-[-0.02em] text-text">
              {member.name}
            </h3>
            <p class="mt-3 font-chulapa text-sm uppercase tracking-[0.12em] text-text/70">
              {member.role}
            </p>
            <div class="mt-5 max-w-[65ch] space-y-3 font-body text-base leading-relaxed text-text/85">
              {member.description.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>
