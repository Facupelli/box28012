---
import { getHomeData } from "../data/home";

const { team } = getHomeData();
---

<div class="mx-auto max-w-350">
  <section id="equipo" class="px-4 py-section md:px-10">
    <header class="space-y-2">
      <h2 class="text-section-title text-text">{team.title}</h2>
      <p class="text-body max-w-[60ch] text-muted">{team.headline}</p>
    </header>

    <div class="mt-section-content grid grid-cols-1 gap-y-12 md:gap-y-14 lg:grid-cols-2 lg:gap-x-14 lg:gap-y-0 xl:gap-x-18">
      {team.members.map((member, index) => (
        <article
          class:list={[
            "min-w-0",
            index === 1 &&
              "border-t border-white/20 pt-12 md:pt-14 lg:border-t-0 lg:pt-0",
          ]}
        >
          <header>
            <h3 class="text-feature-title text-text">{member.name}</h3>
            <p class="text-eyebrow mt-3 text-accent-text">{member.role}</p>
          </header>
          <div class="text-body mt-8 max-w-[43ch] border-t border-white/20 pt-8 text-muted space-y-4 md:space-y-5">
            {member.description.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</div>
