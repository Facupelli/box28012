---
import { Icon } from "astro-icon/components";

const isHome = Astro.url.pathname === "/";
const homePath = isHome ? "" : "/";
const heroTextShadowClasses =
  "md:group-data-[hero=true]:group-data-[menu-open=false]:text-shadow-[0_1px_2px_#000c,0_0_1px_#0008]";
const navItems = [
  { label: "Servicios", href: `${homePath}#servicios` },
  { label: "Actividades", href: `${homePath}#actividades` },
  { label: "Horarios", href: "/horarios/" },
  { label: "Tarifas", href: "/tarifas/" },
  { label: "El Box", href: `${homePath}#el-box` },
  { label: "Contacto", href: `${homePath}#contacto` },
];
---

<nav
  id="main-nav"
  aria-label="Navegación principal"
  data-hero={String(isHome)}
  data-visible="true"
  data-menu-open="false"
  class="group fixed top-0 left-0 z-50 w-full bg-transparent transition-transform duration-600 ease-[cubic-bezier(0.22,1,0.36,1)] data-[hero=false]:bg-bg data-[visible=false]:-translate-y-full max-lg:data-[menu-open=true]:bg-bg"
>
  <!-- Keep contrast behind the mobile header as it moves over the photograph. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-[calc(var(--nav-height)+7rem)] bg-[linear-gradient(180deg,rgba(0,0,0,0.78)_0%,rgba(0,0,0,0.5)_40%,transparent_100%)] opacity-0 group-data-[hero=true]:group-data-[menu-open=false]:opacity-100 md:hidden"
  ></div>
  <div
    data-nav-header
    class="relative z-20 mx-auto flex h-nav max-w-350 items-center justify-between px-4 md:px-10"
  >
    <a
      href={isHome ? "#inicio" : "/"}
      class:list={[
        "font-pontejos-identity text-lg tracking-[-0.06em] lg:text-xl",
        heroTextShadowClasses,
      ]}
    >
      BOX 28012
    </a>

    <!-- DESKTOP -->
    <ul
      class:list={[
        "hidden items-center gap-6 text-text/80 group-data-[hero=true]:text-text lg:flex xl:gap-10",
        heroTextShadowClasses,
      ]}
    >
      {navItems.map((item) => (
        <li>
          {item.href ? (
            <a
              href={item.href}
              class="text-sm font-medium uppercase tracking-[0.18em]"
            >
              {item.label}
            </a>
          ) : (
            <span class="text-sm font-medium uppercase tracking-[0.18em]">
              {item.label}
            </span>
          )}
        </li>
      ))}
    </ul>

    <button
      type="button"
      id="mobile-menu-toggle"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menú"
      class="relative flex size-11 items-center justify-center font-chulapa lg:hidden"
    >
      <Icon
        name="list"
        class="absolute size-7 md:group-data-[hero=true]:drop-shadow-[0_1px_2px_#000c] group-data-[menu-open=true]:hidden"
        aria-hidden="true"
      />
      <Icon
        name="x"
        class="absolute hidden size-7 group-data-[menu-open=true]:block"
        aria-hidden="true"
      />
    </button>
  </div>
</nav>

<noscript>
  <nav
    aria-label="Navegación sin JavaScript"
    class="relative z-50 bg-bg px-4 pt-nav pb-4 lg:hidden"
  >
    <ul class="flex flex-wrap gap-4">
      {navItems.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</noscript>

<!-- MOBILE MENU-->
<div
  id="mobile-menu"
  aria-hidden="true"
  inert
  class="pointer-events-none invisible fixed inset-x-0 top-nav bottom-0 z-40 overflow-y-auto bg-bg opacity-0 transition-[opacity,visibility] duration-300 ease-out lg:hidden"
>
  <ul class="flex min-h-full -translate-y-2 flex-col justify-center gap-10 px-4 py-6 text-[clamp(1.5rem,6vw,2rem)] text-text/80 opacity-0 transition-[opacity,transform] duration-300 ease-out md:px-10">
    {navItems.map((item) => (
      <li>
        {item.href ? (
          <a
            href={item.href}
            class="mobile-menu-link block font-medium uppercase tracking-[0.06em]"
          >
            {item.label}
          </a>
        ) : (
          <span class="block font-medium uppercase tracking-[0.06em] text-muted">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ul>
</div>

<script>
  const nav = document.querySelector<HTMLElement>("#main-nav");
  const hero = document.querySelector<HTMLElement>("#inicio");
  const heroContent = hero?.querySelector<HTMLElement>("[data-hero-content]");
  const navHeader = nav?.querySelector<HTMLElement>("[data-nav-header]");
  const menuToggleButton = document.querySelector<HTMLButtonElement>(
    "#mobile-menu-toggle",
  );
  const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");
  const mobileMenuList = mobileMenu?.querySelector<HTMLElement>("ul");
  const mobileMenuLinks =
    document.querySelectorAll<HTMLAnchorElement>(".mobile-menu-link");

  if (nav && mobileMenu && mobileMenuList) {
    const desktopMedia = window.matchMedia("(min-width: 1024px)");
    let lastScrollY = window.scrollY;
    let ticking = false;
    let isMenuOpen = false;

    const setMenuOpen = (open: boolean) => {
      isMenuOpen = open;

      nav.dataset.menuOpen = String(open);
      menuToggleButton?.setAttribute("aria-expanded", String(open));
      menuToggleButton?.setAttribute(
        "aria-label",
        open ? "Cerrar menú" : "Abrir menú",
      );

      mobileMenu.setAttribute("aria-hidden", String(!open));
      mobileMenu.inert = !open;

      mobileMenu.classList.toggle("opacity-0", !open);
      mobileMenu.classList.toggle("invisible", !open);
      mobileMenu.classList.toggle("pointer-events-none", !open);

      mobileMenuList.classList.toggle("opacity-0", !open);
      mobileMenuList.classList.toggle("-translate-y-2", !open);

      document.documentElement.style.overflow = open ? "hidden" : "";

      if (open) {
        // Wait for the menu's first visible frame before moving focus.
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            if (isMenuOpen) mobileMenuLinks[0]?.focus();
          });
        });
      }
    };

    const updateNav = () => {
      const currentScrollY = window.scrollY;
      const navHeight = navHeader?.offsetHeight ?? nav.offsetHeight;
      const isOverHero =
        (hero?.getBoundingClientRect().bottom ?? 0) > navHeight;
      // On mobile, use a solid background once the hero copy reaches the header.
      const isHero =
        isOverHero &&
        (desktopMedia.matches ||
          (heroContent?.getBoundingClientRect().top ?? 0) > navHeight);
      const isScrollingUp = currentScrollY < lastScrollY;
      const isNearTop = currentScrollY < 8;

      nav.dataset.hero = String(isHero);
      nav.dataset.visible = String(
        isMenuOpen || isOverHero || isScrollingUp || isNearTop,
      );

      lastScrollY = currentScrollY;
      ticking = false;
    };

    const requestUpdate = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateNav);
        ticking = true;
      }
    };

    menuToggleButton?.addEventListener("click", () => {
      setMenuOpen(!isMenuOpen);
      requestUpdate();
    });

    mobileMenuLinks.forEach((link) => {
      link.addEventListener("click", () => {
        setMenuOpen(false);
        requestUpdate();
      });
    });

    window.addEventListener("keydown", (event) => {
      if (!isMenuOpen) return;

      if (event.key === "Escape") {
        event.preventDefault();

        setMenuOpen(false);
        menuToggleButton?.focus();
        requestUpdate();

        return;
      }

      if (event.key !== "Tab") return;

      const focusableElements = [menuToggleButton, ...mobileMenuLinks].filter(
        (element): element is HTMLButtonElement | HTMLAnchorElement =>
          element !== null,
      );

      const firstElement = focusableElements[0];
      const lastElement = focusableElements.at(-1);

      if (!firstElement || !lastElement) return;

      const activeElement = document.activeElement;
      const isFocusInsideMenu = focusableElements.some(
        (element) => element === activeElement,
      );

      if (!isFocusInsideMenu) {
        event.preventDefault();
        (event.shiftKey ? lastElement : firstElement).focus();
        return;
      }

      if (event.shiftKey && activeElement === firstElement) {
        event.preventDefault();
        lastElement.focus();
        return;
      }

      if (!event.shiftKey && activeElement === lastElement) {
        event.preventDefault();
        firstElement.focus();
      }
    });

    window.addEventListener("resize", () => {
      if (desktopMedia.matches) setMenuOpen(false);
      requestUpdate();
    });

    updateNav();
    window.addEventListener("scroll", requestUpdate, { passive: true });
  }
</script>
