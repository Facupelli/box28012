---
import { SITE_INDEXABLE } from "../../site.config.mjs";
import { getImage } from "astro:assets";
import socialPhoto from "../assets/images/box/box-50.jpg";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Entrenamiento funcional y personal en grupos reducidos en Lavapiés, Madrid. Conoce Box 28012 y reserva tu prueba gratis.",
  image,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = await getImage({
  src: socialPhoto,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const ogImageURL = new URL(image ?? socialImage.src, Astro.site);
---

<!-- Primary -->
<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={SITE_INDEXABLE ? "index, follow" : "noindex, nofollow"}
/>
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content="Box 28012" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta
  property="og:image:alt"
  content="Entrenamiento funcional en Box 28012, Lavapiés, Madrid"
/>
{!image && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Theme -->
<meta name="theme-color" content="#131313" />
