---
import { getHomeData } from "../data/home";

const { businessInfo } = getHomeData();
const currentYear = new Date().getFullYear();
---

<footer class="bg-bg">
  <div class="relative isolate flex h-40 items-center justify-center overflow-hidden border-t border-white/10 md:h-52">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 bg-[url('/images/mosaic-v2.webp')] bg-size-[160px_160px] bg-center bg-repeat md:bg-size-[208px_208px]"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 bg-black/20"
    ></div>

    <div class="px-4 pb-6 text-center md:pb-0">
      <p class="font-pontejos-identity text-[clamp(2.75rem,8vw,5rem)] uppercase leading-none tracking-[-0.03em] text-text">
        {businessInfo.name}
      </p>
      <p class="mt-2 font-pontejos-display text-base uppercase leading-none tracking-[0.08em] text-accent md:text-2xl">
        {businessInfo.cityShort}
      </p>
    </div>

    <div class="absolute inset-x-0 bottom-3 mx-auto max-w-[1800px] px-4 md:bottom-4 md:px-10">
      <p class="font-body text-xs leading-relaxed text-muted">
        © {currentYear} {businessInfo.name} · Todos los derechos reservados
      </p>
    </div>
  </div>
</footer>
