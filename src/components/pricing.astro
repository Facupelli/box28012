---
import { getHomeData } from "../data/home";

const { pricing } = getHomeData();
---

<div class="mx-auto max-w-350">
  <section
    id="tarifas"
    class="scroll-mt-18 max-w-220 px-4 py-14 md:px-10 lg:py-30"
  >
    <header class="space-y-2">
      <h2 class="text-section-title text-text">{pricing.title}</h2>
      <p class="font-body text-base leading-relaxed text-muted md:text-lg">
        {pricing.headline}
      </p>
    </header>

    <div class="mt-16 md:mt-20" data-pricing>
      <section aria-labelledby="pricing-group-title">
        <div class="md:flex md:items-end md:justify-between md:gap-8">
          <h3
            id="pricing-group-title"
            class="text-pretty font-pontejos-display text-[clamp(2rem,2.25vw,2.5rem)] leading-none tracking-[-0.02em] text-text"
          >
            {pricing.smallGroup.title}
          </h3>

          <div
            role="tablist"
            aria-label="Periodo de entrenamiento en grupo reducido"
            class="mt-6 flex shrink-0 border-b border-white/20 md:mt-0"
          >
            {pricing.smallGroup.periods.map((period, index) => (
              <button
                type="button"
                role="tab"
                id={`pricing-tab-${period.id}`}
                aria-controls={`pricing-panel-${period.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                data-pricing-tab={period.id}
                class="relative px-1 py-4 font-chulapa text-xs uppercase tracking-[0.16em] text-muted first:mr-7 after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:scale-x-0 after:bg-accent after:content-[''] aria-selected:text-text aria-selected:after:scale-x-100 md:text-sm"
              >
                {period.label}
              </button>
            ))}
          </div>
        </div>

        {pricing.smallGroup.periods.map((period, index) => (
          <div
            id={`pricing-panel-${period.id}`}
            role="tabpanel"
            aria-labelledby={`pricing-tab-${period.id}`}
            tabindex="0"
            hidden={index !== 0}
            data-pricing-panel={period.id}
          >
            <p class="pt-4 font-body text-sm leading-relaxed text-muted md:text-base">
              {period.description}
            </p>

            <div class="mt-8 md:mt-10">
              {period.plans.map((plan, index) => (
                <article class="grid min-w-0 grid-cols-[2rem_minmax(0,1fr)_auto] items-center gap-x-4 gap-y-2 border-b border-white/10 py-6 last:border-b-0 md:min-h-24 md:grid-cols-[2rem_minmax(0,1fr)_minmax(0,1fr)_auto] md:gap-x-8 md:py-8">
                  <span class="col-start-1 row-start-1 font-body text-base font-semibold leading-none text-accent md:text-lg">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h4 class="col-start-2 row-start-1 font-chulapa text-base font-normal uppercase leading-none tracking-[0.08em] text-text md:text-lg lg:text-xl">
                    {plan.name}
                  </h4>
                  <p class="col-start-2 row-start-2 text-pretty font-body text-xs uppercase leading-tight tracking-[0.06em] text-subtle md:col-start-3 md:row-start-1 md:text-sm">
                    {plan.sessionsLabel}
                  </p>
                  <p class="col-start-3 row-start-1 whitespace-nowrap text-right font-pontejos-identity text-[clamp(2rem,2.7vw,2.5rem)] leading-none tracking-[-0.02em] text-text tabular-nums md:col-start-4">
                    {plan.price} €
                  </p>
                </article>
              ))}
            </div>
          </div>
        ))}

        <article class="mt-14">
          <h4 class="font-chulapa text-lg uppercase tracking-[0.08em] text-text md:text-xl">
            {pricing.smallGroup.dropIn.name}
          </h4>
          <p class="mt-4 font-body text-base font-semibold leading-snug text-text md:text-lg">
            {pricing.smallGroup.dropIn.headline}
          </p>
          <div class="mt-3 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 md:gap-8">
            <p class="max-w-140 font-body text-sm leading-relaxed text-muted md:text-base">
              {pricing.smallGroup.dropIn.description}
            </p>
            <p class="whitespace-nowrap text-right font-pontejos-identity text-[clamp(2rem,2.7vw,2.5rem)] leading-none text-text tabular-nums">
              {pricing.smallGroup.dropIn.price} €
              <span class="block pt-2 font-body text-xs uppercase tracking-[0.06em] text-subtle md:text-sm">
                / {pricing.smallGroup.dropIn.unit}
              </span>
            </p>
          </div>
        </article>
      </section>

      <section aria-labelledby="pricing-personal-title" class="mt-24 md:mt-32">
        <h3
          id="pricing-personal-title"
          class="text-pretty font-pontejos-display text-[clamp(2rem,2.25vw,2.5rem)] leading-none tracking-[-0.02em] text-text"
        >
          {pricing.personal.title}
        </h3>
        <p class="max-w-120 pt-4 font-body text-sm leading-relaxed text-muted md:text-base">
          {pricing.personal.description}
        </p>

        <div class="mt-8 md:mt-10">
          {pricing.personal.plans.map((plan, index) => (
            <article class="grid grid-cols-[2rem_minmax(0,1fr)_auto] items-center gap-x-4 border-b border-white/10 py-6 last:border-b-0 md:min-h-24 md:gap-x-8 md:py-8">
              <span class="font-body text-base font-semibold leading-none text-accent md:text-lg">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h4 class="min-w-0 font-chulapa text-base font-normal uppercase leading-tight tracking-[0.08em] text-text md:text-lg lg:text-xl">
                {plan.name}
              </h4>
              <p class="whitespace-nowrap text-right font-pontejos-identity text-[clamp(2rem,2.7vw,2.5rem)] leading-none text-text tabular-nums">
                {plan.price} €
              </p>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>
</div>

<script>
  const pricingSections =
    document.querySelectorAll<HTMLElement>("[data-pricing]");

  pricingSections.forEach((pricing) => {
    const tabs = Array.from(
      pricing.querySelectorAll<HTMLButtonElement>("[data-pricing-tab]"),
    );
    const panels = Array.from(
      pricing.querySelectorAll<HTMLElement>("[data-pricing-panel]"),
    );

    const selectPeriod = (selectedTab: HTMLButtonElement) => {
      const period = selectedTab.dataset.pricingTab;
      if (!period) return;

      tabs.forEach((tab) => {
        const isSelected = tab === selectedTab;
        tab.setAttribute("aria-selected", String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.pricingPanel !== period;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectPeriod(tab));

      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;

        if (event.key === "ArrowRight") {
          nextIndex = (index + 1) % tabs.length;
        }

        if (event.key === "ArrowLeft") {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        }

        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;

        if (nextIndex === undefined) return;

        event.preventDefault();

        const nextTab = tabs[nextIndex];
        if (!nextTab) return;

        selectPeriod(nextTab);
        nextTab.focus();
      });
    });
  });
</script>
