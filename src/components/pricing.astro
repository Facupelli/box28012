---
import { getHomeData } from "../data/home";

const { pricing } = getHomeData();
---

<div class="mx-auto max-w-350">
  <section id="tarifas" class="px-4 py-24 md:px-10 md:py-36">
    <header class="space-y-2">
      <h1 class="font-pontejos-display text-[clamp(2.5rem,5vw,4rem)] leading-none tracking-[-0.02em]">
        {pricing.title}
      </h1>
      <p class="font-body text-base leading-relaxed text-muted md:text-lg">
        {pricing.headline}
      </p>
    </header>

    <div
      class="mt-section-content grid gap-y-20 lg:grid-cols-2 lg:gap-x-20 lg:gap-y-0 xl:gap-x-28"
      data-pricing
    >
      <section
        aria-labelledby="pricing-group-title"
        class="min-w-0 lg:row-span-2 lg:grid lg:grid-rows-subgrid"
      >
        <div>
          <h2
            id="pricing-group-title"
            class="text-pretty font-pontejos-display text-[clamp(1.75rem,2.25vw,2rem)] leading-none tracking-[-0.02em] text-text"
          >
            {pricing.smallGroup.title}
          </h2>

          {pricing.smallGroup.periods.map((period, index) => (
            <p
              id={`pricing-description-${period.id}`}
              hidden={index !== 0}
              data-pricing-period={period.id}
              class="pt-4 font-body text-sm leading-relaxed text-muted md:text-base"
            >
              {period.description}
            </p>
          ))}

          <div
            role="tablist"
            aria-label="Periodo de entrenamiento en grupo reducido"
            class="mt-5 inline-flex border border-white/20"
          >
            {pricing.smallGroup.periods.map((period, index) => (
              <button
                type="button"
                role="tab"
                id={`pricing-tab-${period.id}`}
                aria-controls={`pricing-panel-${period.id}`}
                aria-describedby={`pricing-description-${period.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                data-pricing-tab={period.id}
                class="min-h-11 cursor-pointer px-4 font-chulapa text-xs uppercase tracking-[0.08em] text-muted aria-selected:bg-text aria-selected:text-bg aria-[selected=false]:hover:bg-white/5 aria-[selected=false]:hover:text-text md:text-sm"
              >
                {period.label}
              </button>
            ))}
          </div>
        </div>

        {pricing.smallGroup.periods.map((period, index) => (
          <div
            id={`pricing-panel-${period.id}`}
            role="tabpanel"
            aria-labelledby={`pricing-tab-${period.id}`}
            tabindex="0"
            hidden={index !== 0}
            data-pricing-panel={period.id}
            data-pricing-period={period.id}
          >
            <div class="mt-6">
              {period.plans.map((plan, index) => (
                <article class="grid min-h-20 min-w-0 grid-cols-[1.5rem_minmax(0,1fr)_auto] items-center gap-x-4 border-b border-white/10 py-4 last:border-b-0 md:gap-x-5">
                  <span class="font-body text-sm font-semibold leading-none text-accent">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-chulapa text-base font-normal uppercase leading-tight tracking-[0.08em] text-text md:text-lg">
                      {plan.name}
                    </h3>
                    <p class="mt-2 font-body text-xs uppercase leading-tight tracking-[0.06em] text-muted">
                      {plan.sessionsLabel}
                    </p>
                  </div>
                  <p class="whitespace-nowrap text-right font-pontejos-identity text-[clamp(2rem,2.5vw,2.25rem)] leading-none tracking-[-0.02em] text-text tabular-nums">
                    {plan.price} €
                  </p>
                </article>
              ))}
            </div>
          </div>
        ))}
      </section>

      <section
        aria-labelledby="pricing-personal-title"
        class="min-w-0 lg:row-span-2 lg:grid lg:grid-rows-subgrid"
      >
        <header>
          <h2
            id="pricing-personal-title"
            class="text-pretty font-pontejos-display text-[clamp(1.75rem,2.25vw,2rem)] leading-none tracking-[-0.02em] text-text"
          >
            {pricing.personal.title}
          </h2>
          <p class="max-w-120 pt-4 font-body text-sm leading-relaxed text-muted md:text-base">
            {pricing.personal.description}
          </p>
        </header>

        <div class="mt-6 lg:row-start-2">
          {pricing.personal.plans.map((plan, index) => (
            <article class="grid min-h-20 grid-cols-[1.5rem_minmax(0,1fr)_auto] items-center gap-x-4 border-b border-white/10 py-4 last:border-b-0 md:gap-x-5">
              <span class="font-body text-sm font-semibold leading-none text-accent">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="min-w-0 font-chulapa text-base font-normal uppercase leading-tight tracking-[0.08em] text-text md:text-lg">
                {plan.name}
              </h3>
              <p class="whitespace-nowrap text-right font-pontejos-identity text-[clamp(2rem,2.5vw,2.25rem)] leading-none text-text tabular-nums">
                {plan.price} €
              </p>
            </article>
          ))}
        </div>
      </section>

      <article class="min-w-0 justify-self-start lg:col-span-2 lg:mt-10">
        <h2 class="font-chulapa text-lg uppercase tracking-[0.08em] text-text md:text-xl">
          {pricing.smallGroup.dropIn.name}
        </h2>
        <p class="mt-1 font-body text-base font-semibold leading-snug text-text">
          {pricing.smallGroup.dropIn.headline}
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-4 md:gap-8">
          <p class="font-body text-sm leading-relaxed text-muted">
            {pricing.smallGroup.dropIn.description}
          </p>
          <p class="whitespace-nowrap text-right font-pontejos-identity text-[clamp(2rem,2.5vw,2.25rem)] leading-none text-text tabular-nums">
            {pricing.smallGroup.dropIn.price} €
            <span class="ml-1 font-body text-xs uppercase tracking-[0.06em] text-subtle md:text-sm">
              / {pricing.smallGroup.dropIn.unit}
            </span>
          </p>
        </div>
      </article>
    </div>
  </section>
</div>

<script>
  const pricingSections =
    document.querySelectorAll<HTMLElement>("[data-pricing]");

  pricingSections.forEach((pricing) => {
    const tabs = Array.from(
      pricing.querySelectorAll<HTMLButtonElement>("[data-pricing-tab]"),
    );
    const periodContent = Array.from(
      pricing.querySelectorAll<HTMLElement>("[data-pricing-period]"),
    );

    const selectPeriod = (selectedTab: HTMLButtonElement) => {
      const period = selectedTab.dataset.pricingTab;
      if (!period) return;

      tabs.forEach((tab) => {
        const isSelected = tab === selectedTab;
        tab.setAttribute("aria-selected", String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
      });

      periodContent.forEach((content) => {
        content.hidden = content.dataset.pricingPeriod !== period;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectPeriod(tab));

      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;

        if (event.key === "ArrowRight") {
          nextIndex = (index + 1) % tabs.length;
        }

        if (event.key === "ArrowLeft") {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        }

        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;

        if (nextIndex === undefined) return;

        event.preventDefault();

        const nextTab = tabs[nextIndex];
        if (!nextTab) return;

        selectPeriod(nextTab);
        nextTab.focus();
      });
    });
  });
</script>
