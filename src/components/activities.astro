---
import { getHomeData } from "../data/home";

const { activities } = getHomeData();
---

<section id="actividades" class="scroll-mt-18 bg-bg text-text">
  <div class="mx-auto max-w-350 px-4 py-section md:px-10">
    <h2 class="text-section-title text-text/80">{activities.title}</h2>

    <div class="mt-section-content divide-y divide-white/20">
      {activities.items.map((activity, index) => (
        <article class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-4 gap-y-5 py-8 md:grid-cols-[3rem_minmax(0,0.8fr)_minmax(0,1.2fr)] md:gap-x-8 md:py-10">
          <span class="pt-1 font-body text-sm font-semibold leading-none text-accent md:text-base">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="font-pontejos-display text-[clamp(2rem,3vw,2.5rem)] leading-none tracking-[-0.02em] text-text">
            {activity.title}
          </h3>
          <div class="col-start-2 md:col-start-3">
            <p class="font-body text-base font-bold leading-snug text-text md:text-lg">
              {activity.claim}
            </p>
            <p class="mt-3 max-w-140 text-pretty font-body text-base leading-relaxed text-muted md:text-lg">
              {activity.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
