---
import Image from "astro/components/Image.astro";
import { getHomeData } from "../data/home";

const { services } = getHomeData();
---

<div class="mx-auto max-w-350">
  <section id="servicios" class="scroll-mt-18 px-4 py-section md:px-10">
    <h2 class="text-section-title text-text/80">{services.title}</h2>

    <div class="mt-section-content grid grid-cols-1 gap-6 lg:max-w-292 lg:grid-cols-2 lg:gap-8">
      {services.items.map((service) => (
        <article class="relative isolate flex min-h-145 flex-col justify-end overflow-hidden bg-surface p-6 sm:min-h-170 sm:p-10 lg:min-h-175">
          <Image
            src={service.image}
            alt={service.alt}
            width={960}
            height={1200}
            fit="cover"
            widths={[480, 720, 960, 1200, 1600]}
            sizes="(min-width: 1248px) 568px, (min-width: 1024px) calc((100vw - 112px) / 2), (min-width: 768px) calc(100vw - 80px), calc(100vw - 32px)"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 -z-20 size-full object-cover"
          />

          <div class="service-panel-content relative">
            <h3 class="max-w-120 text-balance font-pontejos-display text-[clamp(2rem,2.8vw,2.625rem)] font-normal leading-[1.05] tracking-[-0.02em] text-text">
              {service.title}
            </h3>

            <p class="mt-5 max-w-120 text-pretty font-body text-lg font-bold leading-snug text-text">
              {service.claim}
            </p>

            <p class="mt-3 max-w-120 text-pretty font-body text-base leading-relaxed text-text/85">
              {service.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>

<style>
  .service-panel-content::before {
    position: absolute;
    z-index: -10;
    inset: -10rem -2.5rem -2.5rem;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(0 0 0 / 72%) 10rem,
      rgb(0 0 0 / 94%) 100%
    );
    content: "";
  }
</style>
