---
import Image from "astro/components/Image.astro";
import { getHomeData } from "../data/home";

const { services } = getHomeData();
---

<div class="grid grid-cols-1 gap-12 pt-10 md:pt-14 lg:grid-cols-2 lg:gap-8 xl:gap-12">
	{
		services.map((service) => (
			<article class="grid content-start">
				<figure class="aspect-4/3 overflow-hidden bg-black">
					<Image
						src={service.image}
						alt={service.alt}
						class="size-full object-cover"
					/>
				</figure>

				<div class="pt-5 md:pt-7">
					<h3 class="text-card-title font-normal">{service.title}</h3>

					<div class="my-4 h-px bg-white/10 md:my-5">
						<div class="h-px w-10 bg-accent" />
					</div>

					<p class="max-w-145 text-body leading-relaxed">
						{service.description}
					</p>
				</div>
			</article>
		))
	}
</div>
