---
import Image from "astro/components/Image.astro";
import { getHomeData } from "../data/home";

const { services } = getHomeData();
---

<div class="mx-auto max-w-350">
  <section id="servicios" class="px-4 pt-section pb-section-compact md:px-10">
    <h2 class="text-section-title text-text/80">{services.title}</h2>

    <div class="mt-section-content grid grid-cols-1 gap-6 lg:min-h-160 lg:grid-cols-2 lg:grid-rows-[1fr_auto_auto_auto] lg:gap-x-8 lg:gap-y-0">
      {services.items.map((service) => (
        <article class="relative isolate flex min-h-130 flex-col justify-end overflow-hidden bg-surface p-6 sm:p-10 md:min-h-170 lg:min-h-160 lg:row-span-4 lg:grid lg:grid-cols-1 lg:grid-rows-subgrid lg:justify-normal">
          <Image
            src={service.image}
            alt={service.alt}
            width={960}
            height={1200}
            fit="cover"
            widths={[480, 720, 960, 1200, 1600]}
            sizes="(min-width: 1400px) 644px, (min-width: 1024px) calc((100vw - 112px) / 2), (min-width: 768px) calc(100vw - 80px), calc(100vw - 32px)"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 -z-20 size-full object-cover"
          />

          <div class="service-panel-content relative lg:row-span-3 lg:row-start-2 lg:grid lg:grid-rows-subgrid">
            <h3 class="text-card-title max-w-120 text-text">{service.title}</h3>

            <p class="text-claim mt-5 max-w-120 text-text">{service.claim}</p>

            <p class="text-body mt-3 max-w-120 text-text/90">
              {service.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>

<style>
  .service-panel-content::before {
    position: absolute;
    z-index: -10;
    inset: -10rem -2.5rem -2.5rem;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(0 0 0 / 72%) 10rem,
      rgb(0 0 0 / 94%) 100%
    );
    content: "";
  }
</style>
